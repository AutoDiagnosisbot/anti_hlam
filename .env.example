POSTGRES_DB=anti_hlam
POSTGRES_USER=anti_hlam
POSTGRES_PASSWORD=change_this_password

# Plain HTTP keeps the current behavior on http://host:8083.
APP_HTTP_BIND=8083

# HTTPS is optional and enabled with: docker compose --profile https up -d
# For production on https://your-domain:8083, use:
# APP_HTTP_BIND=127.0.0.1:18083
# HTTP_BIND=80
# HTTPS_BIND=8083
# PUBLIC_HTTPS_PORT=8083
# DOMAIN=your-domain.example
# LETSENCRYPT_EMAIL=you@example.com
# CERTBOT_STAGING=0
